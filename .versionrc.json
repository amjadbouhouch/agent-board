{
  "bumpFiles": [
    { "filename": "package.json", "type": "json" },
    { "filename": "src/version.ts", "updater": "scripts/version-updater.cjs" }
  ],
  "types": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Refactoring" },
    { "type": "docs", "section": "Documentation" },
    { "type": "test", "hidden": true },
    { "type": "chore", "hidden": true },
    { "type": "ci", "hidden": true }
  ],
  "commitUrlFormat": "https://github.com/amjadbouhouch/agent-board/commit/{{hash}}",
  "compareUrlFormat": "https://github.com/amjadbouhouch/agent-board/compare/{{previousTag}}...{{currentTag}}"
}
